# Copy this to .env.local and adjust as needed. Never commit .env.local.
#
# Loading vars from this file into your shell BEFORE starting uvicorn makes
# them win over .env (see load_dotenv(..., override=False) in src/api/app.py),
# without touching your real .env or production Firestore/LiveAgent state.

AUTO_ASSIGN_STORE=file
AGENTS_SOURCE=file
AUTO_ASSIGN_STATE_PATH=./data/local_test_state.json

# Any value works locally - this just has to match what you send in the
# X-CMX-Auto-Assign-Secret header when you curl your local server.
WEBHOOK_SECRET=local-test-secret

# Only needed if you also want to hit /admin/* endpoints locally.
ADMIN_BEARER_TOKENS=local-test-admin-token

# LIVEAGENT_API_KEY is intentionally NOT overridden here - there's no sandbox
# LiveAgent instance, so real LiveAgent calls always hit production. Only
# point auto-assign at a real ticket if you created it yourself for testing.
